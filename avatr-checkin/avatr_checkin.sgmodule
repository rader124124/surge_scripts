#!name=AVATR Daily Check-in
#!desc=Capture AVATR auth locally, refresh token, generate fresh signatures, then check in daily.
#!system=ios

[Script]
AVATR Capture Auth = type=http-response,pattern=^https:\/\/appserver-view\.avatr\.com\/v5\/base-view\/auth\/getNewToken,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/rader124124/surge_scripts/rm/avatr-checkin/avatr_checkin.js
AVATR Capture H5 Context = type=http-request,pattern=^https:\/\/m\.avatr\.com\/api\/v6\/signIn\/,script-path=https://raw.githubusercontent.com/rader124124/surge_scripts/rm/avatr-checkin/avatr_checkin.js

# Default time: 09:15 every day.
AVATR Daily Check-in = type=cron,cronexp="15 9 * * *",wake-system=1,script-path=https://raw.githubusercontent.com/rader124124/surge_scripts/rm/avatr-checkin/avatr_checkin.js

[MITM]
hostname = %APPEND% appserver-view.avatr.com, m.avatr.com
